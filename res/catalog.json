  {
    "id": "orca",
    "kind": "tool",
    "detect": {
      "bin": "orca",
      "version_args": [
        "--version"
      ],
      "sessions": {
        "match": [
          "/opt/Orca/",
          "Orca.app/Contents/MacOS/",
          "\\Programs\\orca\\"
        ]
      }
    },
    "install": {
      "linux": [
        {
          "method": "deb",
          "cmd": "python3 res/tools/orca.py"
        }
      ],
      "macos": [
        {
          "method": "app",
          "cmd": "python3 res/tools/orca.py"
        }
      ],
      "windows": [
        {
          "method": "user-setup",
          "cmd": "python res/tools/orca.py"
        }
      ]
    },
    "packages": {
      "winget": "StablyAI.Orca",
      "deb": "orca-ide",
      "brew_cask": "stablyai/orca/orca"
    },
    "update": null,
    "uninstall": {
      "linux": [
        {
          "method": "deb",
          "cmd": "python3 res/tools/orca.py --uninstall"
        }
      ],
      "macos": [
        {
          "method": "app",
          "cmd": "python3 res/tools/orca.py --uninstall"
        }
      ],
      "windows": [
        {
          "method": "user-setup",
          "cmd": "python res/tools/orca.py --uninstall"
        }
      ]
    }
  },

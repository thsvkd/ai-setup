[
  {
    "id": "claude",
    "kind": "harness",
    "detect": {
      "bin": "claude",
      "version_args": [
        "--version"
      ],
      "sessions": {
        "ignore": [
          "AnthropicClaude"
        ]
      }
    },
    "install": {
      "linux": [
        {
          "method": "native",
          "cmd": "curl -fsSL https://claude.ai/install.sh | bash"
        }
      ],
      "macos": [
        {
          "method": "native",
          "cmd": "curl -fsSL https://claude.ai/install.sh | bash"
        }
      ],
      "windows": [
        {
          "method": "native",
          "cmd": "irm https://claude.ai/install.ps1 | iex"
        }
      ]
    },
    "packages": {
      "npm": "@anthropic-ai/claude-code",
      "winget": "Anthropic.ClaudeCode",
      "brew_cask": "claude-code"
    },
    "update": [
      "claude",
      "update"
    ],
    "plugin_update": [
      [
        "claude",
        "plugin",
        "marketplace",
        "update"
      ]
    ]
  },
  {

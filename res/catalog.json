        }
      ]
    },
    "packages": {
      "npm": "@openai/codex",
      "brew_cask": "codex"
    },
    "update": [
      "codex",
      "update"
    ],
    "plugin_update": [
      [
        "codex",
        "plugin",
        "marketplace",
        "upgrade"
      ]
    ]
  },
